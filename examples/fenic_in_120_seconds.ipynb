    "\n",
    "tickets_df = session.create_dataframe(support_tickets)\n",
    "\n",
    "print(\"🎫 Incoming Support Tickets:\")\n",
    "print(\"=\" * 35)\n",
    "tickets_df.select(\"ticket_id\", \"subject\", \"customer_type\").show()\n",
    "\n",
    "# 🎯 Analyze and route tickets automatically\n",
    "analyzed_tickets = tickets_df.select(\n",
    "    \"ticket_id\",\n",
    "    \"customer_id\",\n",
    "    \"customer_type\",\n",
    "    \"subject\",\n",
    "    fc.semantic.extract(\n",
    "        fc.semantic.map(\n",
    "            \"\"\"Analyze this customer support ticket for routing and prioritization:\n",
    "            \n",
    "            Subject: {subject}\n",
    "            Customer Type: {customer_type}\n",
    "            Message: {message}\n",
    "            \n",
    "            Determine the best team to handle this, urgency level, and recommended actions.\n",
    "            Consider customer type (enterprise gets priority) and issue complexity.\"\"\",\n",
    "            subject=fc.builtin.col(\"subject\"),\n",
    "            customer_type=fc.builtin.col(\"customer_type\"),\n",
    "            message=fc.builtin.col(\"message\")\n",
    "        ),\n",
    "        SupportTicketAnalysis,\n",
    "        model_alias=\"openai_smart\"  # Use smart model for nuanced customer service analysis\n",
    "    ).alias(\"analysis\")\n",
    ")\n",
    "\n",
    "# 📊 Display routing recommendations\n",
    "routing_results = analyzed_tickets.select(\n",
    "    \"ticket_id\",\n",
    "    \"customer_type\",\n",
    "    analyzed_tickets.analysis.routing_team.alias(\"assigned_team\"),\n",
    "    analyzed_tickets.analysis.urgency_level.alias(\"urgency\"),\n",
    "    analyzed_tickets.analysis.estimated_resolution_time.alias(\"eta\"),\n",
    "    analyzed_tickets.analysis.customer_sentiment.alias(\"sentiment\"),\n",
    "    analyzed_tickets.analysis.requires_escalation.alias(\"escalate\")\n",
    ")\n",
    "\n",
    "print(\"\\n🎯 Automatic Ticket Routing Results:\")\n",
    "print(\"=\" * 45)\n",
    "routing_results.show()\n",
    "\n",
    "# 🚨 Critical tickets requiring immediate attention\n",
    "critical_tickets = analyzed_tickets.filter(\n",
    "    (analyzed_tickets.analysis.urgency_level == \"critical\") |\n",
    "    (analyzed_tickets.analysis.urgency_level == \"high\") |\n",
    "    (analyzed_tickets.analysis.requires_escalation == True)\n",
    ").select(\n",
    "    \"ticket_id\",\n",
    "    \"subject\",\n",
    "    analyzed_tickets.analysis.routing_team.alias(\"team\"),\n",
    "    analyzed_tickets.analysis.key_issues.alias(\"issues\"),\n",
    "    analyzed_tickets.analysis.suggested_actions.alias(\"actions\")\n",
    ")\n",
    "\n",
    "print(\"\\n🚨 Critical Tickets - Immediate Action Required:\")\n",
    "print(\"=\" * 50)\n",
    "critical_tickets.show()\n",
    "\n",
    "# 📈 Team workload distribution\n",
    "team_workload = analyzed_tickets.group_by(\n",
    "    analyzed_tickets.analysis.routing_team\n",
    ").agg(\n",
    "    fc.builtin.count(\"*\").alias(\"ticket_count\")\n",
    ")\n",
    "\n",
    "urgency_distribution = analyzed_tickets.group_by(\n",
    "    analyzed_tickets.analysis.urgency_level\n",
    ").agg(\n",
    "    fc.builtin.count(\"*\").alias(\"count\")\n",
    ")\n",
    "\n",
    "print(\"\\n📈 Team Workload Distribution:\")\n",
    "print(\"=\" * 35)\n",
    "team_workload.show()\n",
    "\n",
    "print(\"\\n⚡ Urgency Distribution:\")\n",
    "print(\"=\" * 25)\n",
    "urgency_distribution.show()\n",
    "\n",
    "print(\"\\n💡 Automatic routing ensures tickets reach the right team faster!\")\n",
    "print(\"🎯 Critical issues are identified and escalated immediately.\")"
   ]
