  {
   "cell_type": "code",
   "execution_count": null,
   "id": "contract-analysis",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ⚖️ Contract analysis schema\n",
    "class ContractRiskAnalysis(BaseModel):\n",
    "    contract_type: str = Field(description=\"Type of contract (service, employment, vendor, lease, etc.)\")\n",
    "    risk_level: Literal[\"low\", \"medium\", \"high\", \"critical\"] = Field(description=\"Overall risk assessment\")\n",
    "    key_terms: List[str] = Field(description=\"Important contract terms and conditions\")\n",
    "    red_flags: List[str] = Field(description=\"Specific clauses or terms that pose risks\")\n",
    "    payment_terms: str = Field(description=\"Summary of payment obligations and timeline\")\n",
    "    termination_conditions: str = Field(description=\"How and when the contract can be terminated\")\n",
    "    liability_concerns: List[str] = Field(description=\"Liability and indemnification issues\")\n",
    "    requires_legal_review: bool = Field(description=\"Whether this contract needs attorney review\")\n",
    "    recommended_actions: List[str] = Field(description=\"Suggested next steps or modifications\")\n",
    "\n",
    "# 📄 Sample contract clauses (realistic examples with various risk levels)\n",
    "contract_samples = [\n",
    "    {\n",
    "        \"contract_id\": \"CONTRACT_001\",\n",
    "        \"vendor\": \"CloudTech Solutions\",\n",
    "        \"text\": \"\"\"SERVICE AGREEMENT: CloudTech Solutions will provide cloud hosting services for $5,000/month. \n",
    "        Payment due within 30 days of invoice. Either party may terminate with 60 days written notice. \n",
    "        CloudTech provides 99.5% uptime guarantee with service credits for violations. \n",
    "        Client data remains property of client. Standard liability limited to 12 months of fees paid. \n",
    "        Both parties agree to resolve disputes through binding arbitration in Delaware.\"\"\"\n",
    "    },\n",
    "    {\n",
    "        \"contract_id\": \"CONTRACT_002\",\n",
    "        \"vendor\": \"DataFlow Systems\",\n",
    "        \"text\": \"\"\"MASTER SERVICE AGREEMENT: Client agrees to minimum 3-year commitment at $15,000/month with automatic renewal. \n",
    "        NO TERMINATION allowed except for material breach (90 days cure period). Payment due within 10 days or service suspended immediately. \n",
    "        DataFlow may change pricing with 30 days notice. Client grants DataFlow unlimited rights to use client data for 'service improvement.' \n",
    "        DataFlow liability limited to $100 regardless of damages. Client indemnifies DataFlow against ALL claims. \n",
    "        Disputes subject to DataFlow's internal arbitration process only.\"\"\"\n",
    "    },\n",
    "    {\n",
    "        \"contract_id\": \"CONTRACT_003\",\n",
    "        \"vendor\": \"Office Space LLC\",\n",
    "        \"text\": \"\"\"COMMERCIAL LEASE: 24-month lease for 2,500 sq ft office space at $8,000/month plus utilities. \n",
    "        First month, last month, and security deposit ($24,000 total) due at signing. \n",
    "        Tenant responsible for ALL maintenance and repairs regardless of cause. Property taxes passed through to tenant. \n",
    "        Landlord may enter premises at any time without notice. No assignment or subletting permitted. \n",
    "        Personal guarantees required from all company officers. Early termination requires 6 months additional rent.\"\"\"\n",
    "    },\n",
    "    {\n",
    "        \"contract_id\": \"CONTRACT_004\",\n",
    "        \"vendor\": \"Marketing Partners Inc\",\n",
    "        \"text\": \"\"\"MARKETING SERVICES AGREEMENT: 12-month engagement for $3,000/month digital marketing services. \n",
    "        Either party may terminate with 30 days notice. Payment terms NET 45 days. \n",
    "        Marketing Partners provides monthly reporting and campaign optimization. \n",
    "        Client retains ownership of all creative assets and data. Reasonable liability cap of $36,000 (annual fee). \n",
    "        Standard confidentiality and non-compete provisions apply.\"\"\"\n",
    "    }\n",
    "]\n",
    "\n",
    "contracts_df = session.create_dataframe(contract_samples)\n",
    "\n",
    "# ⚖️ Analyze contracts for risks and key terms\n",
    "contract_analysis = contracts_df.select(\n",
    "    \"contract_id\",\n",
    "    \"vendor\",\n",
    "    fc.semantic.extract(\n",
    "        \"text\",\n",
    "        ContractRiskAnalysis,\n",
    "        model_alias=\"openai_smart\"  # Use capable model for legal analysis\n",
    "    ).alias(\"analysis\")\n",
    ")\n",
    "\n",
    "# 📊 Display comprehensive risk analysis\n",
    "risk_summary = contract_analysis.select(\n",
    "    \"contract_id\",\n",
    "    \"vendor\",\n",
    "    contract_analysis.analysis.contract_type.alias(\"type\"),\n",
    "    contract_analysis.analysis.risk_level.alias(\"risk\"),\n",
    "    contract_analysis.analysis.requires_legal_review.alias(\"legal_review_needed\")\n",
    ")\n",
    "\n",
    "print(\"📋 Contract Risk Analysis Summary:\")\n",
    "print(\"=\" * 50)\n",
    "risk_summary.show()\n",
    "\n",
    "# 🚨 Detailed analysis for high-risk contracts\n",
    "high_risk_contracts = contract_analysis.filter(\n",
    "    (contract_analysis.analysis.risk_level == \"high\") | \n",
    "    (contract_analysis.analysis.risk_level == \"critical\")\n",
    ").select(\n",
    "    \"contract_id\",\n",
    "    \"vendor\",\n",
    "    contract_analysis.analysis.red_flags.alias(\"red_flags\"),\n",
    "    contract_analysis.analysis.liability_concerns.alias(\"liability_issues\"),\n",
    "    contract_analysis.analysis.recommended_actions.alias(\"recommendations\")\n",
    ")\n",
    "\n",
    "print(\"\\n🚨 High-Risk Contracts Requiring Attention:\")\n",
    "print(\"=\" * 50)\n",
    "high_risk_contracts.show()\n",
    "\n",
    "# 📈 Risk distribution analysis\n",
    "risk_distribution = contract_analysis.group_by(\n",
    "    contract_analysis.analysis.risk_level\n",
    ").agg(fc.builtin.count(\"*\").alias(\"count\"))\n",
    "\n",
    "legal_review_needed = contract_analysis.filter(\n",
    "    contract_analysis.analysis.requires_legal_review == True\n",
    ").count()\n",
    "\n",
    "print(\"\\n📈 Risk Distribution:\")\n",
    "risk_distribution.show()\n",
    "\n",
    "print(f\"\\n⚖️ Contracts requiring legal review: {legal_review_needed}/{contracts_df.count()}\")\n",
    "print(\"💡 AI-powered contract analysis helps prioritize legal team attention!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "transaction-enrichment-header",\n",
   "metadata": {},\n",
   "source": [
    "# 💳 Example 13: Real-World Use Case - Transaction Enrichment\n",
    "\n",
    "**Hook:** *\"Make raw transactions human-friendly\"*\n",
    "\n",
    "Bank transactions are cryptic - \"SQ*COFFEE SHOP\" tells you nothing useful. Fenic can enrich transaction data with merchant names, categories, and context, making financial data actually useful for budgeting, expense reporting, and analysis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "transaction-enrichment",\n",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 💰 Transaction enrichment schema\n",
    "class TransactionEnrichment(BaseModel):\n",
    "    merchant_name: str = Field(description=\"Clean, readable merchant name\")\n",
    "    category: Literal[\n",
    "        \"food_dining\", \"grocery\", \"gas_fuel\", \"shopping\", \"entertainment\", \n",
    "        \"transportation\", \"healthcare\", \"utilities\", \"subscription\", \"business\", \"other\"\n",
    "    ] = Field(description=\"Transaction category\")\n",
    "    subcategory: str = Field(description=\"More specific category (e.g., 'coffee shop', 'ride share')\")\n",
    "    is_recurring: bool = Field(description=\"Whether this appears to be a recurring payment\")\n",
    "    business_expense: bool = Field(description=\"Likely business-related expense\")\n",
    "    location_type: Literal[\"online\", \"physical_store\", \"app\", \"unknown\"] = Field(\n",
    "        description=\"Type of transaction location\"\n",
    "    )\n",
    "    notes: str = Field(description=\"Additional context or insights about the transaction\")\n",
    "\n",
    "# 💳 Raw bank transaction data (the cryptic kind we all see)\n",
    "raw_transactions = [\n",
    "    {\n",
    "        \"transaction_id\": \"TXN001\",\n",
    "        \"date\": \"2024-01-15\",\n",
    "        \"amount\": -4.75,\n",
    "        \"description\": \"SQ *BLUE BOTTLE COFFEE\",\n",
    "        \"raw_merchant\": \"SQ *BLUE BOTTLE COFFEE SAN FRANCISCO CA\"\n",
    "    },\n",
    "    {\n",
    "        \"transaction_id\": \"TXN002\", \n",
    "        \"date\": \"2024-01-15\",\n",
    "        \"amount\": -89.99,\n",
    "        \"description\": \"AMZN Mktp US*2A3B4C5D6\",\n",
    "        \"raw_merchant\": \"AMZN MKTP US*2A3B4C5D6 AMZN.COM/BILL WA\"\n",
    "    },\n",
    "    {\n",
    "        \"transaction_id\": \"TXN003\",\n",
    "        \"date\": \"2024-01-16\", \n",
    "        \"amount\": -12.99,\n",
    "        \"description\": \"NETFLIX.COM\",\n",
    "        \"raw_merchant\": \"NETFLIX.COM NETFLIX.COM CA\"\n",
    "    },\n",
    "    {\n",
    "        \"transaction_id\": \"TXN004\",\n",
    "        \"date\": \"2024-01-16\",\n",
    "        \"amount\": -15.50,\n",
    "        \"description\": \"UBER *TRIP 9ABC2\",\n",
    "        \"raw_merchant\": \"UBER *TRIP 9ABC2 HELP.UBER.COM CA\"\n",
    "    },\n",
    "    {\n",
    "        \"transaction_id\": \"TXN005\",\n",
    "        \"date\": \"2024-01-17\",\n",
    "        \"amount\": -67.43,\n",
    "        \"description\": \"WHOLEFDS #10394\",\n",
    "        \"raw_merchant\": \"WHOLEFDS #10394 SAN FRANCISCO CA\"\n",
    "    },\n",
    "    {\n",
    "        \"transaction_id\": \"TXN006\",\n",
    "        \"date\": \"2024-01-17\", \n",
    "        \"amount\": -39.99,\n",
    "        \"description\": \"GITHUB, INC.\",\n",
    "        \"raw_merchant\": \"GITHUB, INC. 88 COLIN P KELLY SF CA\"\n",
    "    },\n",
    "    {\n",
    "        \"transaction_id\": \"TXN007\",\n",
    "        \"date\": \"2024-01-18\",\n",
    "        \"amount\": -3.50,\n",
    "        \"description\": \"SHELL OIL 57478302\",\n",
    "        \"raw_merchant\": \"SHELL OIL 57478302 SAN FRANCISCO CA\"\n",
    "    },\n",
    "    {\n",
    "        \"transaction_id\": \"TXN008\",\n",
    "        \"date\": \"2024-01-18\",\n",
    "        \"amount\": -1200.00,\n",
    "        \"description\": \"CHECK #1234 RENT PAYMENT\",\n",
    "        \"raw_merchant\": \"CHECK #1234\"\n",
    "    }\n",
    "]\n",
    "\n",
    "transactions_df = session.create_dataframe(raw_transactions)\n",
    "\n",
    "print(\"💳 Raw Transaction Data:\")\n",
    "print(\"=\" * 30)\n",
    "transactions_df.show()\n",
    "\n",
    "# 💰 Enrich transactions with AI\n",
    "enriched_transactions = transactions_df.select(\n",
    "    \"transaction_id\",\n",
    "    \"date\",\n",
    "    \"amount\",\n",
    "    \"description\",\n",
    "    fc.semantic.extract(\n",
    "        fc.semantic.map(\n",
    "            \"\"\"Analyze this bank transaction and provide enriched information:\n",
    "            \n",
    "            Transaction: {description}\n",
    "            Amount: {amount}\n",
    "            Raw merchant data: {raw_merchant}\n",
    "            \n",
    "            Provide a clean merchant name, appropriate category, and useful context.\n",
    "            Consider if this is a subscription, business expense, or recurring payment.\"\"\",\n",
    "            description=fc.builtin.col(\"description\"),\n",
    "            amount=fc.builtin.col(\"amount\"),\n",
    "            raw_merchant=fc.builtin.col(\"raw_merchant\")\n",
    "        ),\n",
    "        TransactionEnrichment,\n",
    "        model_alias=\"openai_fast\"\n",
    "    ).alias(\"enriched\")\n",
    ")\n",
    "\n",
    "# 📊 Display enriched transaction data\n",
    "readable_transactions = enriched_transactions.select(\n",
    "    \"transaction_id\",\n",
    "    \"date\",\n",
    "    \"amount\",\n",
    "    enriched_transactions.enriched.merchant_name.alias(\"merchant\"),\n",
    "    enriched_transactions.enriched.category.alias(\"category\"),\n",
    "    enriched_transactions.enriched.subcategory.alias(\"subcategory\"),\n",
    "    enriched_transactions.enriched.is_recurring.alias(\"recurring\"),\n",
    "    enriched_transactions.enriched.business_expense.alias(\"business\")\n",
    ")\n",
    "\n",
    "print(\"\\n💰 Enriched Transaction Data:\")\n",
    "print(\"=\" * 40)\n",
    "readable_transactions.show()\n",
    "\n",
    "# 📈 Spending analysis made easy\n",
    "category_spending = enriched_transactions.select(\n",
    "    enriched_transactions.enriched.category.alias(\"category\"),\n",
    "    fc.builtin.col(\"amount\")\n",
    ").group_by(\"category\").agg(\n",
    "    fc.builtin.sum(\"amount\").alias(\"total_spent\"),\n",
    "    fc.builtin.count(\"*\").alias(\"transaction_count\")\n",
    ")\n",
    "\n",
    "print(\"\\n📈 Spending by Category:\")\n",
    "print(\"=\" * 30)\n",
    "category_spending.show()\n",
    "\n",
    "# 🔄 Identify recurring expenses\n",
    "recurring_expenses = enriched_transactions.filter(\n",
    "    enriched_transactions.enriched.is_recurring == True\n",
    ").select(\n",
    "    enriched_transactions.enriched.merchant_name.alias(\"service\"),\n",
    "    \"amount\",\n",
    "    enriched_transactions.enriched.notes.alias(\"details\")\n",
    ")\n",
    "\n",
    "print(\"\\n🔄 Recurring Expenses:\")\n",
    "print(\"=\" * 25)\n",
    "recurring_expenses.show()\n",
    "\n",
    "print(\"\\n💡 Transaction enrichment makes financial data actually useful!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "content-clustering-header",\n",
   "metadata": {},\n",
   "source": [
    "# 📚 Example 14: Real-World Use Case - Content Clustering\n",
    "\n",
    "**Hook:** *\"Turn your content sprawl into an encyclopedia\"*\n",
    "\n",
    "Got thousands of blog posts, articles, or documents scattered everywhere? Fenic's semantic clustering groups related content together, helping you organize knowledge bases, discover content gaps, and build better information architectures."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "content-clustering",\n",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 📰 Sample blog articles from a tech company\n",
    "blog_articles = [\n",
    "    {\n",
    "        \"article_id\": \"ART001\",\n",
    "        \"title\": \"Getting Started with Machine Learning: A Beginner's Guide\",\n",
    "        \"content\": \"Machine learning is transforming how we build software. This guide covers the basics of supervised learning, neural networks, and how to choose the right algorithm for your problem. We'll walk through practical examples using Python and scikit-learn.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART002\", \n",
    "        \"title\": \"10 Essential JavaScript Performance Tips\",\n",
    "        \"content\": \"JavaScript performance can make or break user experience. Learn about code splitting, lazy loading, efficient DOM manipulation, and memory management. These optimization techniques will make your web apps lightning fast.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART003\",\n",
    "        \"title\": \"Deep Dive: Transformer Architecture in NLP\", \n",
    "        \"content\": \"Transformers revolutionized natural language processing. Understanding attention mechanisms, positional encoding, and the encoder-decoder structure is crucial for modern AI applications. We'll implement a basic transformer from scratch.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART004\",\n",
    "        \"title\": \"React Hooks: Best Practices and Common Pitfalls\",\n",
    "        \"content\": \"React hooks changed how we write components. This article covers useState, useEffect, custom hooks, and performance considerations. Avoid common mistakes and write cleaner, more maintainable React code.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART005\",\n",
    "        \"title\": \"Computer Vision with OpenCV: Object Detection Tutorial\",\n",
    "        \"content\": \"Learn to build object detection systems using OpenCV and Python. We'll cover image preprocessing, feature extraction, and implementing YOLO for real-time detection. Perfect for robotics and automation projects.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART006\",\n",
    "        \"title\": \"CSS Grid vs Flexbox: When to Use Which\",\n",
    "        \"content\": \"CSS Grid and Flexbox are powerful layout tools. Grid excels at two-dimensional layouts while Flexbox handles one-dimensional arrangements. Learn the strengths of each and build responsive designs efficiently.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART007\",\n",
    "        \"title\": \"Introduction to Reinforcement Learning\",\n",
    "        \"content\": \"Reinforcement learning enables AI agents to learn through interaction. Explore Q-learning, policy gradients, and deep RL algorithms. We'll build a game-playing AI that learns to win through trial and error.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART008\",\n",
    "        \"title\": \"Modern TypeScript: Advanced Types and Patterns\",\n",
    "        \"content\": \"TypeScript's type system is incredibly powerful. Master conditional types, mapped types, template literals, and advanced patterns. Build type-safe applications with confidence and catch bugs at compile time.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART009\",\n",
    "        \"title\": \"Deployment Strategies: Blue-Green vs Rolling Updates\",\n",
    "        \"content\": \"Choosing the right deployment strategy minimizes downtime and risk. Compare blue-green deployments, rolling updates, and canary releases. Learn when to use each approach for maximum reliability.\"\n",
    "    },\n",
    "    {\n",
    "        \"article_id\": \"ART010\",\n",
    "        \"title\": \"Building Recommendation Systems with Collaborative Filtering\",\n",
    "        \"content\": \"Recommendation engines power modern platforms. Understand user-based and item-based collaborative filtering, matrix factorization, and deep learning approaches. Build a Netflix-style recommendation system.\"\n",
    "    }\n",
    "]\n",
    "\n",
    "articles_df = session.create_dataframe(blog_articles)\n",
    "\n",
    "# 🔍 First, create embeddings for semantic similarity\n",
    "articles_with_embeddings = articles_df.select(\n",
    "    \"*\",\n",
    "    fc.embedding.embed(\n",
    "        fc.builtin.concat(\n",
    "            fc.builtin.col(\"title\"), \n",
    "            fc.builtin.lit(\" \"), \n",
    "            fc.builtin.col(\"content\")\n",
    "        )\n",
    "    ).alias(\"content_embedding\")\n",
    ")\n",
    "\n",
    "# 📊 Cluster articles into topic groups\n",
    "clustered_articles = articles_with_embeddings.semantic.with_cluster_labels(\n",
    "    by=\"content_embedding\",\n",
    "    num_clusters=4,  # Group into 4 main topic areas\n",
    "    label_column=\"topic_cluster\"\n",
    ")\n",
    "\n",
    "# 🏷️ Generate cluster labels using AI\n",
    "class ClusterLabel(BaseModel):\n",
    "    topic_name: str = Field(description=\"Descriptive name for this content cluster\")\n",
    "    description: str = Field(description=\"Brief description of what articles in this cluster cover\")\n",
    "    keywords: List[str] = Field(description=\"Key terms and concepts for this topic\")\n",
    "\n",
    "# Group articles by cluster and get sample titles for labeling\n",
    "cluster_samples = clustered_articles.select(\n",
    "    \"topic_cluster\",\n",
    "    \"title\",\n",
    "    \"content\"\n",
    ").group_by(\"topic_cluster\").agg(\n",
    "    fc.builtin.collect_list(\"title\").alias(\"titles\"),\n",
    "    fc.builtin.count(\"*\").alias(\"article_count\")\n",
    ")\n",
    "\n",
    "# Generate cluster labels\n",
    "labeled_clusters = cluster_samples.select(\n",
    "    \"topic_cluster\",\n",
    "    \"article_count\",\n",
    "    fc.semantic.extract(\n",
    "        fc.semantic.map(\n",
    "            \"\"\"Based on these article titles, create a descriptive label for this content cluster:\n",
    "            \n",
    "            Articles in cluster:\n",
    "            {titles}\n",
    "            \n",
    "            Generate a topic name, description, and relevant keywords for this cluster.\"\"\",\n",
    "            titles=fc.builtin.col(\"titles\")\n",
    "        ),\n",
    "        ClusterLabel,\n",
    "        model_alias=\"openai_fast\"\n",
    "    ).alias(\"cluster_info\")\n",
    ")\n",
    "\n",
    "# 📚 Display cluster analysis\n",
    "cluster_summary = labeled_clusters.select(\n",
    "    \"topic_cluster\",\n",
    "    \"article_count\",\n",
    "    labeled_clusters.cluster_info.topic_name.alias(\"topic_name\"),\n",
    "    labeled_clusters.cluster_info.description.alias(\"description\"),\n",
    "    labeled_clusters.cluster_info.keywords.alias(\"keywords\")\n",
    ")\n",
    "\n",
    "print(\"📚 Content Cluster Analysis:\")\n",
    "print(\"=\" * 40)\n",
    "cluster_summary.show()\n",
    "\n",
    "# 📋 Show articles organized by cluster\n",
    "organized_content = clustered_articles.select(\n",
    "    \"article_id\",\n",
    "    \"title\", \n",
    "    \"topic_cluster\"\n",
    ").order_by(\"topic_cluster\")\n",
    "\n",
    "print(\"\\n📋 Articles Organized by Topic Cluster:\")\n",
    "print(\"=\" * 45)\n",
    "organized_content.show()\n",
    "\n",
    "# 🔍 Identify content gaps\n",
    "print(\"\\n🔍 Content Analysis Insights:\")\n",
    "print(\"=\" * 35)\n",
    "for cluster_id in range(4):\n",
    "    cluster_info = cluster_summary.filter(cluster_summary[\"topic_cluster\"] == cluster_id).collect()\n",
    "    if cluster_info:\n",
    "        info = cluster_info[0]\n",
    "        print(f\"Cluster {cluster_id}: {info['topic_name']} ({info['article_count']} articles)\")\n",
    "        print(f\"  Keywords: {', '.join(info['keywords'][:5])}\")\n",
    "        print()\n",
    "\n",
    "print(\"💡 Use this clustering to organize your content library and identify gaps!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "support-routing-header",\n",
   "metadata": {},\n",
   "source": [
    "# 🎧 Example 15: Real-World Use Case - Customer Support Routing\n",
    "\n",
    "**Hook:** *\"Route tickets to the right team automatically\"*\n",
    "\n",
    "Customer support tickets pile up and get misrouted constantly. Fenic can analyze ticket content, extract key information, determine urgency, and route to the correct team - all automatically. This reduces response times and improves customer satisfaction."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "support-routing",\n",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🎫 Support ticket routing schema\n",
    "class SupportTicketAnalysis(BaseModel):\n",
    "    category: Literal[\n",
    "        \"billing\", \"technical\", \"account\", \"feature_request\", \"bug_report\", \"general_inquiry\"\n",
    "    ] = Field(description=\"Primary category of the support request\")\n",
    "    \n",
    "    routing_team: Literal[\n",
    "        \"billing_team\", \"technical_support\", \"account_management\", \"product_team\", \"engineering\", \"general_support\"\n",
    "    ] = Field(description=\"Which team should handle this ticket\")\n",
    "    \n",
    "    urgency_level: Literal[\"low\", \"medium\", \"high\", \"critical\"] = Field(\n",
    "        description=\"How urgent is this issue\"\n",
    "    )\n",
    "    \n",
    "    estimated_resolution_time: Literal[\n",
    "        \"immediate\", \"same_day\", \"2_3_days\", \"1_week\", \"2_weeks_plus\"\n",
    "    ] = Field(description=\"Expected time to resolve\")\n",
    "    \n",
    "    key_issues: List[str] = Field(description=\"Main problems or requests mentioned\")\n",
    "    customer_sentiment: Literal[\"angry\", \"frustrated\", \"neutral\", \"positive\"] = Field(\n",
    "        description=\"Customer's emotional state\"\n",
    "    )\n",
    "    requires_escalation: bool = Field(description=\"Does this need manager/senior attention\")\n",
    "    suggested_actions: List[str] = Field(description=\"Recommended next steps\")\n",
    "\n",
    "# 🎫 Realistic customer support tickets\n",
    "support_tickets = [\n",
    "    {\n",
    "        \"ticket_id\": \"SUPP001\",\n",
    "        \"customer_id\": \"CUST12345\",\n",
    "        \"subject\": \"URGENT: Payment processed but account still suspended!\",\n",
