   "source": [
    "# 📚 Simulate a large batch of product reviews (this would be thousands in real use)\n",
    "import random\n",
    "\n",
    "# Template reviews for demonstration\n",
    "review_templates = [\n",
    "    \"This product is {quality}! {detail} Would {recommendation} recommend to others.\",\n",
    "    \"I've been using this for {duration} and it's been {experience}. {detail} Overall {rating} stars.\",\n",
    "    \"{sentiment} experience with this product. {detail} Customer service was {service_quality}.\",\n",
    "    \"For the price, this is {value}. {detail} {final_thought}.\"\n",
    "]\n",
    "\n",
    "qualities = [\"amazing\", \"terrible\", \"decent\", \"outstanding\", \"disappointing\", \"good\"]\n",
    "details = [\n",
    "    \"The build quality exceeded my expectations.\",\n",
    "    \"Had some issues with durability after a few weeks.\", \n",
    "    \"Easy to set up and use daily.\",\n",
    "    \"The design is sleek but functionality could be better.\",\n",
    "    \"Exactly what I was looking for in this price range.\",\n",
    "    \"Would not purchase again due to various issues.\"\n",
    "]\n",
    "recommendations = [\"definitely\", \"not\", \"probably\", \"maybe\"]\n",
    "durations = [\"2 weeks\", \"3 months\", \"a year\", \"6 months\"]\n",
    "experiences = [\"great\", \"frustrating\", \"smooth\", \"mixed\"]\n",
    "\n",
    "# Generate batch of reviews\n",
    "batch_reviews = []\n",
    "for i in range(50):  # In production, this could be thousands\n",
    "    template = random.choice(review_templates)\n",
    "    review = template.format(\n",
    "        quality=random.choice(qualities),\n",
    "        detail=random.choice(details),\n",
    "        recommendation=random.choice(recommendations),\n",
    "        duration=random.choice(durations),\n",
    "        experience=random.choice(experiences),\n",
    "        sentiment=random.choice([\"Great\", \"Poor\", \"Mixed\", \"Excellent\"]),\n",
    "        service_quality=random.choice([\"helpful\", \"slow\", \"excellent\", \"poor\"]),\n",
    "        rating=random.choice([\"5\", \"3\", \"4\", \"2\", \"1\"]),\n",
    "        value=random.choice([\"excellent value\", \"overpriced\", \"fair\", \"a steal\"]),\n",
    "        final_thought=random.choice([\"Highly recommend\", \"Skip this one\", \"Consider alternatives\", \"Perfect choice\"])\n",
    "    )\n",
    "    batch_reviews.append({\n",
    "        \"review_id\": f\"R{i+1:03d}\",\n",
    "        \"product_id\": f\"PROD_{random.randint(1, 10)}\",\n",
    "        \"review_text\": review\n",
    "    })\n",
    "\n",
    "# 🚀 Process entire batch with semantic operations\n",
    "print(f\"⚡ Processing {len(batch_reviews)} reviews in batch...\")\n",
    "reviews_df = session.create_dataframe(batch_reviews)\n",
    "\n",
    "# 📊 Batch analysis with multiple semantic operations\n",
    "batch_analyzed = reviews_df.select(\n",
    "    \"review_id\",\n",
    "    \"product_id\",\n",
    "    # Sentiment classification\n",
    "    fc.semantic.classify(\n",
    "        \"review_text\", \n",
    "        [\"positive\", \"negative\", \"neutral\"],\n",
    "        model_alias=\"openai_fast\"\n",
    "    ).alias(\"sentiment\"),\n",
    "    # Rating extraction\n",
    "    fc.semantic.classify(\n",
    "        \"review_text\",\n",
    "        [\"1_star\", \"2_star\", \"3_star\", \"4_star\", \"5_star\"],\n",
    "        model_alias=\"openai_fast\" \n",
    "    ).alias(\"predicted_rating\")\n",
    ")\n",
    "\n",
    "print(\"📊 Batch Processing Results:\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Show sample of results\n",
    "print(\"Sample of processed reviews:\")\n",
    "batch_analyzed.limit(10).show()\n",
    "\n",
    "# 📈 Aggregate insights from batch processing\n",
    "sentiment_distribution = batch_analyzed.group_by(\"sentiment\").agg(\n",
    "    fc.builtin.count(\"*\").alias(\"count\")\n",
    ")\n",
    "\n",
    "rating_distribution = batch_analyzed.group_by(\"predicted_rating\").agg(\n",
    "    fc.builtin.count(\"*\").alias(\"count\")\n",
    ")\n",
    "\n",
    "print(\"\\n📈 Sentiment Distribution:\")\n",
    "sentiment_distribution.show()\n",
    "\n",
    "print(\"\\n⭐ Rating Distribution:\")\n",
    "rating_distribution.show()\n",
    "\n",
    "print(f\"\\n✅ Successfully processed {len(batch_reviews)} reviews with semantic analysis!\")\n",
    "print(\"💡 Fenic automatically handled batching, rate limits, and parallel processing.\")"
   ]
  },
