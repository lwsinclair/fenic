    "# 🛡️ Example 11: Real-World Use Case - Content Moderation\n",
    "\n",
    "**Hook:** *\"AI content moderation in <100 lines of code\"*\n",
    "\n",
    "Content moderation is critical for social platforms, dating apps, and forums. Traditional approaches use keyword filters that are easily bypassed. Fenic's semantic understanding catches sophisticated bad actors, subtle harassment, and context-dependent violations that rule-based systems miss."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "content-moderation",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🔍 Define moderation schema\n",
    "class ModerationResult(BaseModel):\n",
    "    is_safe: bool = Field(description=\"Whether the content is safe for the platform\")\n",
    "    violation_type: Optional[str] = Field(\n",
    "        description=\"Type of violation if unsafe: spam, harassment, inappropriate, scam, hate_speech, or adult_content\"\n",
    "    )\n",
    "    confidence_score: float = Field(\n",
    "        description=\"Confidence in the moderation decision (0.0 to 1.0)\",\n",
    "        ge=0.0,\n",
    "        le=1.0\n",
    "    )\n",
    "    explanation: str = Field(description=\"Brief explanation of the decision\")\n",
    "    requires_human_review: bool = Field(description=\"Whether this needs human moderator review\")\n",
    "\n",
    "# 📱 Sample user-generated content (including edge cases that fool traditional filters)\n",
    "user_content = [\n",
    "    {\n",
    "        \"content_id\": \"C001\",\n",
    "        \"user_id\": \"user123\", \n",
    "        \"content\": \"Hey beautiful! I noticed you're new here. Want to chat privately? I can help you make some easy money from home 💰 Just send me your number!\",\n",
    "        \"platform\": \"dating_app\"\n",
    "    },\n",
    "    {\n",
    "        \"content_id\": \"C002\",\n",
    "        \"user_id\": \"user456\",\n",
    "        \"content\": \"This restaurant has amazing pasta! The tiramisu was perfect too. Highly recommend for a romantic dinner date 🍝❤️\",\n",
    "        \"platform\": \"dating_app\"\n",
    "    },\n",
    "    {\n",
    "        \"content_id\": \"C003\",\n",
    "        \"user_id\": \"user789\",\n",
    "        \"content\": \"I'm a successful entrepreneur looking for someone special. I travel frequently for business and own multiple properties. Let's grab coffee sometime!\",\n",
    "        \"platform\": \"dating_app\"\n",
    "    },\n",
    "    {\n",
    "        \"content_id\": \"C004\",\n",
    "        \"user_id\": \"spammer1\",\n",
    "        \"content\": \"🔥 CRYPTO ALERT 🔥 This new coin is going to the MOON! 🚀 Get in NOW before it's too late! Link in my bio for exclusive access! #NotFinancialAdvice #ToTheMoon\",\n",
    "        \"platform\": \"social_forum\"\n",
    "    },\n",
    "    {\n",
    "        \"content_id\": \"C005\", \n",
    "        \"user_id\": \"user999\",\n",
    "        \"content\": \"You people from that community always cause problems. Maybe you should go back to where you came from instead of ruining things here.\",\n",
    "        \"platform\": \"social_forum\"\n",
    "    },\n",
    "    {\n",
    "        \"content_id\": \"C006\",\n",
    "        \"user_id\": \"helper_bot\",\n",
    "        \"content\": \"Welcome to our community! Here are some helpful tips for new members: 1) Read our community guidelines 2) Introduce yourself in the welcome thread 3) Feel free to ask questions - we're here to help!\",\n",
    "        \"platform\": \"social_forum\"\n",
    "    }\n",
    "]\n",
    "\n",
    "content_df = session.create_dataframe(user_content)\n",
    "\n",
    "# 🛡️ Apply AI-powered content moderation\n",
    "moderated_content = content_df.select(\n",
    "    \"content_id\",\n",
    "    \"user_id\",\n",
    "    \"platform\",\n",
    "    \"content\",\n",
    "    fc.semantic.extract(\n",
    "        fc.semantic.map(\n",
    "            \"\"\"Analyze this user-generated content for safety violations. Consider:\n",
    "            \n",
    "            PLATFORM CONTEXT: This is from a {platform}\n",
    "            \n",
    "            Look for:\n",
    "            - Scam attempts (asking for money/personal info)\n",
    "            - Spam or promotional content\n",
    "            - Harassment or inappropriate behavior  \n",
    "            - Hate speech or discriminatory language\n",
    "            - Adult/inappropriate content\n",
    "            \n",
    "            Content to analyze: {content}\n",
    "            \n",
    "            Be nuanced - normal conversation should pass, obvious violations should fail.\"\"\",\n",
    "            platform=fc.builtin.col(\"platform\"),\n",
    "            content=fc.builtin.col(\"content\")\n",
    "        ),\n",
    "        ModerationResult,\n",
    "        model_alias=\"openai_smart\"  # Use smart model for nuanced moderation decisions\n",
    "    ).alias(\"moderation\")\n",
    ")\n",
    "\n",
    "# 📊 Display moderation results\n",
    "moderation_summary = moderated_content.select(\n",
    "    \"content_id\",\n",
    "    \"user_id\",\n",
    "    moderated_content.moderation.is_safe.alias(\"safe\"),\n",
    "    moderated_content.moderation.violation_type.alias(\"violation\"),\n",
    "    moderated_content.moderation.confidence_score.alias(\"confidence\"),\n",
    "    moderated_content.moderation.requires_human_review.alias(\"needs_review\"),\n",
    "    moderated_content.moderation.explanation.alias(\"explanation\")\n",
    ")\n",
    "\n",
    "print(\"🛡️ AI Content Moderation Results:\")\n",
    "print(\"=\" * 50)\n",
    "moderation_summary.show()\n",
    "\n",
    "# 🚨 Identify content requiring immediate action\n",
    "flagged_content = moderated_content.filter(\n",
    "    (moderated_content.moderation.is_safe == False) | \n",
    "    (moderated_content.moderation.requires_human_review == True)\n",
    ").select(\n",
    "    \"content_id\",\n",
    "    \"user_id\",\n",
    "    moderated_content.moderation.violation_type.alias(\"violation\"),\n",
    "    moderated_content.moderation.explanation.alias(\"reason\")\n",
    ")\n",
    "\n",
    "print(\"\\n🚨 Flagged Content Requiring Action:\")\n",
    "print(\"=\" * 40)\n",
    "flagged_content.show()\n",
    "\n",
    "# 📈 Moderation statistics\n",
    "total_content = moderated_content.count()\n",
    "safe_content = moderated_content.filter(moderated_content.moderation.is_safe == True).count()\n",
    "flagged = total_content - safe_content\n",
    "\n",
    "print(f\"\\n📈 Moderation Statistics:\")\n",
    "print(f\"Total content analyzed: {total_content}\")\n",
    "print(f\"Safe content: {safe_content} ({safe_content/total_content*100:.1f}%)\")\n",
    "print(f\"Flagged content: {flagged} ({flagged/total_content*100:.1f}%)\")\n",
    "print(\"\\n💡 This moderation system catches nuanced violations that keyword filters miss!\")"
   ]
