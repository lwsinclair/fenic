    "# ✅ Example 10: Productivity - Schema Validation\n",
    "\n",
    "**Hook:** *\"Enforce data quality with Pydantic schemas\"*\n",
    "\n",
    "Garbage in, garbage out - except with Fenic. Pydantic schemas ensure that LLMs return exactly the data structure you need, with type validation, required fields, and custom validation rules. Your downstream processing becomes predictable and reliable."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "schema-validation",
   "metadata": {},
   "outputs": [],
   "source": [
    "from datetime import datetime\n",
    "from typing import Literal\n",
    "from pydantic import BaseModel, Field, validator, field_validator\n",
    "\n",
    "# 🛡️ Define strict schema with validation rules\n",
    "class EventExtraction(BaseModel):\n",
    "    \"\"\"Schema for extracting structured event information with strict validation.\"\"\"\n",
    "    \n",
    "    event_name: str = Field(\n",
    "        description=\"Name of the event\",\n",
    "        min_length=3,\n",
    "        max_length=100\n",
    "    )\n",
    "    \n",
    "    event_type: Literal[\"conference\", \"workshop\", \"webinar\", \"meeting\", \"social\"] = Field(\n",
    "        description=\"Type of event from predefined categories\"\n",
    "    )\n",
    "    \n",
    "    start_date: str = Field(\n",
    "        description=\"Event start date in YYYY-MM-DD format\"\n",
    "    )\n",
    "    \n",
    "    duration_hours: int = Field(\n",
    "        description=\"Event duration in hours\",\n",
    "        ge=1,  # Greater than or equal to 1\n",
    "        le=24  # Less than or equal to 24\n",
    "    )\n",
    "    \n",
    "    attendee_count: Optional[int] = Field(\n",
    "        description=\"Expected number of attendees\",\n",
    "        ge=1,\n",
    "        default=None\n",
    "    )\n",
    "    \n",
    "    location: str = Field(\n",
    "        description=\"Event location (city, venue, or 'online')\",\n",
    "        min_length=2\n",
    "    )\n",
    "    \n",
    "    is_free: bool = Field(\n",
    "        description=\"Whether the event is free to attend\"\n",
    "    )\n",
    "    \n",
    "    tags: List[str] = Field(\n",
    "        description=\"Relevant tags or categories\",\n",
    "        max_items=5\n",
    "    )\n",
    "\n",
    "    @field_validator('start_date')\n",
    "    def validate_date_format(cls, v):\n",
    "        \"\"\"Ensure date is in correct format.\"\"\"\n",
    "        try:\n",
    "            datetime.strptime(v, '%Y-%m-%d')\n",
    "            return v\n",
    "        except ValueError:\n",
    "            raise ValueError('Date must be in YYYY-MM-DD format')\n",
    "\n",
    "# 📅 Unstructured event descriptions\n",
    "event_descriptions = [\n",
    "    {\n",
    "        \"description_id\": \"EVT001\",\n",
    "        \"text\": \"Join us for the AI in Healthcare Summit on March 15th, 2024! This two-day conference in San Francisco will bring together 500+ professionals to explore the latest innovations. Registration is $299 per person. Topics include ML diagnostics, patient data privacy, and automated treatment planning.\"\n",
    "    },\n",
    "    {\n",
    "        \"description_id\": \"EVT002\", \n",
    "        \"text\": \"Free online workshop: 'Introduction to Python for Data Science' happening next Tuesday from 2-5 PM EST. Perfect for beginners! We'll cover pandas, numpy, and basic visualization. Limited to 50 participants - register now!\"\n",
    "    },\n",
    "    {\n",
    "        \"description_id\": \"EVT003\",\n",
    "        \"text\": \"Monthly team standup meeting scheduled for December 8th at our downtown office. Expected duration: 90 minutes starting at 10 AM. All 25 team members are required to attend. We'll review Q4 goals and plan for next year.\"\n",
    "    },\n",
    "    {\n",
    "        \"description_id\": \"EVT004\",\n",
    "        \"text\": \"Networking happy hour at Tech Hub co-working space! Friday evening from 6-8 PM. Come meet fellow entrepreneurs and developers in a casual setting. Drinks and appetizers provided at no cost. RSVP appreciated but not required.\"\n",
    "    }\n",
    "]\n",
    "\n",
    "events_df = session.create_dataframe(event_descriptions)\n",
    "\n",
    "# ✅ Extract with strict schema validation\n",
    "extracted_events = events_df.select(\n",
    "    \"description_id\",\n",
    "    fc.semantic.extract(\n",
    "        \"text\",\n",
    "        EventExtraction,  # Pydantic will enforce all validation rules\n",
    "        model_alias=\"openai_smart\"  # Use more capable model for complex extraction\n",
    "    ).alias(\"event_data\")\n",
    ")\n",
    "\n",
    "# 📊 Display validated, structured event data\n",
    "structured_events = extracted_events.select(\n",
    "    \"description_id\",\n",
    "    extracted_events.event_data.event_name.alias(\"name\"),\n",
    "    extracted_events.event_data.event_type.alias(\"type\"),\n",
    "    extracted_events.event_data.start_date.alias(\"date\"),\n",
    "    extracted_events.event_data.duration_hours.alias(\"hours\"),\n",
    "    extracted_events.event_data.location.alias(\"location\"),\n",
    "    extracted_events.event_data.is_free.alias(\"free\"),\n",
    "    extracted_events.event_data.attendee_count.alias(\"attendees\"),\n",
    "    extracted_events.event_data.tags.alias(\"tags\")\n",
    ")\n",
    "\n",
    "print(\"✅ Schema-Validated Event Extraction:\")\n",
    "print(\"=\" * 50)\n",
    "print(\"(All data guaranteed to match schema requirements)\")\n",
    "print()\n",
    "structured_events.show()\n",
    "\n",
    "# 🔍 Verify data quality with aggregations\n",
    "print(\"\\n📊 Data Quality Check:\")\n",
    "print(\"=\" * 30)\n",
    "\n",
    "event_type_dist = structured_events.group_by(\"type\").agg(fc.builtin.count(\"*\").alias(\"count\"))\n",
    "print(\"Event types (all valid enum values):\")\n",
    "event_type_dist.show()\n",
    "\n",
    "free_events = structured_events.filter(structured_events[\"free\"] == True).count()\n",
    "total_events = structured_events.count()\n",
    "print(f\"\\n💰 Free events: {free_events}/{total_events}\")\n",
    "print(\"🎯 100% of extracted data passed schema validation!\")"
   ]
  },
